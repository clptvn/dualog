{
  "id": "codex",
  "displayName": "Codex",

  "binary": {
    "default": "codex",
    "versionArgs": ["--version"],
    "installHint": "https://github.com/openai/codex"
  },

  "engines": {
    "default": "tmux-interactive",
    "allowed": ["tmux-interactive", "headless"]
  },

  "capabilities": {
    "modelFlag": true,
    "reasoningEffort": true,
    "toolProfiles": "prompt-only",
    "addDir": true,
    "writesFiles": true,
    "tuiDrivable": "yes"
  },

  "reasoningEfforts": ["low", "medium", "high", "xhigh", "max", "ultra"],
  "effortDelivery": "argv",
  "modelAliases": { "gpt-5.6": "gpt-5.6-sol" },
  "models": [
    {
      "id": "gpt-5.6-sol",
      "efforts": ["low", "medium", "high", "xhigh", "max", "ultra"],
      "defaultEffort": "low",
      "context": 272000
    },
    {
      "id": "gpt-5.6-terra",
      "efforts": ["low", "medium", "high", "xhigh", "max", "ultra"],
      "defaultEffort": "medium",
      "context": 272000
    },
    {
      "id": "gpt-5.6-luna",
      "efforts": ["low", "medium", "high", "xhigh", "max"],
      "defaultEffort": "medium",
      "context": 272000
    },
    {
      "id": "gpt-5.5",
      "efforts": ["low", "medium", "high", "xhigh"],
      "defaultEffort": "medium",
      "context": 272000
    },
    {
      "id": "gpt-5.4",
      "efforts": ["low", "medium", "high", "xhigh"],
      "defaultEffort": "medium",
      "context": 272000
    },
    {
      "id": "gpt-5.4-mini",
      "efforts": ["low", "medium", "high", "xhigh"],
      "defaultEffort": "medium",
      "context": 272000
    },
    {
      "id": "gpt-5.3-codex-spark",
      "efforts": ["low", "medium", "high", "xhigh"],
      "defaultEffort": "high",
      "context": 128000
    }
  ],

  "discovery": {
    "strategy": "local-cache",
    "format": "codex-cache",
    "path": "{{configHome}}/models_cache.json",
    "catalogProvider": "openai"
  },

  "defaultToolProfile": "read",
  "nativeSubagents": {
    "toolProfile": "pr-review",
    "instructions": "Use the native spawn_agent tool to create one isolated agent per aspect, then wait for all agents. Explicitly request parallel delegation. Do not fork the full orchestrator conversation into children. Preserve the parent's model and reasoning effort rather than selecting a different custom role. Close the child agents after collecting their results."
  },
  "toolProfiles": { "pr-review": {} },

  "mcp": { "strategy": "config-dir" },

  "configIsolation": {
    "env": "CODEX_HOME",
    "dir": "{{scratchDir}}/codex-home",
    "seedFromEnv": "CODEX_HOME",
    "seedFromFallback": "{{home}}/.codex",
    "copyIfMissing": ["auth.json"],
    "copyIfExists": ["version.json", "config.toml"],
    "dropTomlTables": { "config.toml": ["mcp_servers.dualog"] }
  },

  "promptDelivery": { "tmux-interactive": "argv", "headless": "argv" },

  "argv": {
    "tmux-interactive": [
      {
        "when": { "equals": { "key": "toolProfile", "value": "pr-review" } },
        "args": ["-c", "agents.enabled=true", "-c", "agents.max_concurrent_threads_per_session=6"]
      },
      {
        "args": [
          "-C",
          "{{projectPath}}",
          "--sandbox",
          "workspace-write",
          "--add-dir",
          "{{sessionDir}}",
          "--ask-for-approval",
          "never",
          "--no-alt-screen",
          "-c",
          "approval_policy=\"never\""
        ]
      },
      { "when": { "set": "speed" }, "args": ["-p", "{{speed}}", "-c", "service_tier=\"{{speed}}\"", "-c", "features.{{speed}}_mode=true"] },
      { "when": { "notSet": "speed" }, "args": ["-c", "service_tier=\"default\""] },
      { "when": { "set": "model" }, "args": ["--model", "{{model}}"] },
      {
        "when": { "set": "reasoningEffort" },
        "args": ["-c", "model_reasoning_effort={{reasoningEffortJson}}"]
      },
      { "when": { "set": "initialPrompt" }, "args": ["{{initialPrompt}}"] }
    ],
    "headless": [
      {
        "when": { "equals": { "key": "toolProfile", "value": "pr-review" } },
        "args": ["-c", "agents.enabled=true", "-c", "agents.max_concurrent_threads_per_session=6"]
      },
      {
        "args": [
          "exec",
          "--cd",
          "{{projectPath}}",
          "--sandbox",
          "workspace-write",
          "--add-dir",
          "{{sessionDir}}",
          "-c",
          "approval_policy=\"never\""
        ]
      },
      { "when": { "set": "speed" }, "args": ["-p", "{{speed}}", "-c", "service_tier=\"{{speed}}\"", "-c", "features.{{speed}}_mode=true"] },
      { "when": { "notSet": "speed" }, "args": ["-c", "service_tier=\"default\""] },
      { "when": { "set": "model" }, "args": ["--model", "{{model}}"] },
      {
        "when": { "set": "reasoningEffort" },
        "args": ["-c", "model_reasoning_effort={{reasoningEffortJson}}"]
      },
      { "when": { "set": "initialPrompt" }, "args": ["{{initialPrompt}}"] }
    ]
  },

  "tui": {
    "readyAll": ["OpenAI Codex"],
    "readyAny": ["›", "Context ", "/model to change", "Tip: Try the Codex App"],
    "notReady": ["Booting MCP server", "re:model:\\s+loading"],
    "idle": [
      "re:[\\u276F\\u203A]\\s*$",
      "/model to change",
      "tip: try the codex app",
      "context "
    ],
    "blocked": [
      "re:Allow the\\s+.+?\\s+MCP server to run tool"
    ],
    "startupPrompts": [
      {
        "kind": "workspace_trust",
        "description": "trusted-directory option",
        "input": "1",
        "matchAll": [
          "Do you trust the contents of this directory",
          "Yes, continue",
          "No, quit"
        ]
      },
      {
        "kind": "workspace_trust",
        "description": "trusted-directory option",
        "input": "1",
        "matchAll": ["Do you trust", "Trusting the directory", "No, quit"]
      }
    ],
    "exitCommand": "/exit",
    "usesAltScreen": false
  },

  "completion": { "sidecar": "always", "stdoutTrustworthy": false }
}
