{
  "id": "goose",
  "displayName": "Goose",
  "binary": {
    "default": "goose",
    "versionArgs": ["--version"],
    "installHint": "https://block.github.io/goose/docs/getting-started/installation"
  },
  "engines": { "default": "headless", "allowed": ["headless"] },
  "capabilities": {
    "modelFlag": true,
    "reasoningEffort": true,
    "toolProfiles": "prompt-only",
    "addDir": false,
    "writesFiles": true,
    "tuiDrivable": "risky"
  },
  "reasoningEfforts": ["off", "low", "medium", "high", "max"],
  "effortAliases": { "xhigh": "max" },
  "effortDelivery": "env",
  "models": [],
  "discovery": {
    "strategy": "http-openai",
    "baseUrlEnv": ["OPENAI_HOST", "OLLAMA_HOST"],
    "apiKeyEnv": ["OPENAI_API_KEY"],
    "capabilityProbe": "ollama-show"
  },
  "defaultToolProfile": "read",
  "nativeSubagents": {
    "toolProfile": "pr-review",
    "instructions": "Use the Summon extension's delegate tool (summon__delegate). Issue one foreground delegate call per aspect together in the same batch and await every result. Do not use the removed background subagent or orchestrator APIs. Pass each child's manifest task as its instructions."
  },
  "toolProfiles": { "pr-review": {} },
  "mcp": { "strategy": "flag" },
  "configIsolation": {
    "env": "GOOSE_PATH_ROOT",
    "dir": "{{scratchDir}}/goose-root",
    "extraEnv": { "GOOSE_DISABLE_KEYRING": "1" }
  },
  "env": { "GOOSE_MODE": "auto", "GOOSE_THINKING_EFFORT": "{{reasoningEffort}}" },
  "promptDelivery": { "headless": "argv" },
  "argv": {
    "headless": [
      { "args": ["run", "--no-session", "--no-profile", "--with-builtin", "developer", "-q"] },
      { "when": { "equals": { "key": "toolProfile", "value": "pr-review" } }, "args": ["--with-builtin", "summon"] },
      { "when": { "set": "model" }, "args": ["--model", "{{model}}"] },
      { "args": ["-t", "{{initialPrompt}}"] }
    ]
  },
  "completion": { "sidecar": "always", "stdoutTrustworthy": false }
}
